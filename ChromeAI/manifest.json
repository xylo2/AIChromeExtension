{
  "manifest_version": 3,
  "name": "Google AI Code Collapser & Watch Clipboard",
  "version": "2.4.0",
  "description": "Allège les blocs de code Google AI et pilote watch_clipboard en temps réel.",
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watch Clipboard & Code Collapser"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": false,
      "js": [
        "spill_detector.js",
        "chat_injector.js",
        "git_panel.js",
        "block_manager.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
