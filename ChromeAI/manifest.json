{
  "manifest_version": 3,
  "name": "Google AI Code Collapser & Watch Clipboard",
  "version": "2.8.0",
  "description": "Allège les blocs de code Google AI, affiche l'aperçu SVG au survol et pilote watch_clipboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watch Clipboard & Code Collapser",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": false,
      "js": [
        "spill_heuristics.js",
        "spill_detector.js",
        "file_attacher.js",
        "chat_injector.js",
        "composer_ui.js",
        "export_menu.js",
        "git_commit_ui.js",
        "git_panel.js",
        "test_panel.js",
        "test_actions.js",
        "svg_sanitizer.js",
        "svg_preview.js",
        "block_verifier.js",
        "block_controls_ui.js",
        "block_manager.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
